# ---- 공통 ----
# 세션 토큰 서명 비밀키 (아무 긴 문자열). 배포 시 반드시 변경
SESSION_SECRET=change-me-to-a-long-random-string
# 최초 총관리자 (명부에 총관리자가 없을 때 한 번만 생성됨)
ADMIN_NAME=관리자
ADMIN_CODE=ADMIN123

# ---- 배포(Supabase) ----
# 둘 다 비어 있으면 로컬 SQLite(data/vote.sqlite)를 사용
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- 선거인명부 암호화 (v1.1) ----
# 각각 32바이트 임의 값. `openssl rand -base64 32` 로 두 번 만들어 넣으세요.
# 비어 있으면 로컬 개발용 고정 키를 씁니다 (배포 환경에서는 명부 기능이 멈춤).
# 잃어버리면 명부를 다시 올려야 하고 백업 복원이 안 되므로, 위원장·간사가 오프라인 사본을 1부씩 보관하세요.
VOTER_ENC_KEY=
VOTER_HMAC_KEY=
